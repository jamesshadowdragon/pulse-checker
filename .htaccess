# ============================================================
# PulseCheck API - .htaccess
# ============================================================

# Enable CORS headers
<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Methods "GET, POST, DELETE, OPTIONS"
    Header set Access-Control-Allow-Headers "Content-Type, Authorization, X-PulseCheck-Token"
    Header set Access-Control-Max-Age "3600"
</IfModule>

# Handle OPTIONS preflight requests
RewriteEngine On
RewriteCond %{REQUEST_METHOD} OPTIONS
RewriteRule ^(.*)$ $1 [R=200,L]

# Block direct access to monitors directory
RewriteRule ^monitors/ - [F,L]

# Block access to config files
<Files "config.php">
    Order Allow,Deny
    Deny from all
</Files>

# Allow index.php
<Files "index.php">
    Order Deny,Allow
    Allow from all
</Files>
